# dz-sandbox Environment Configuration Example
# Copy this file to .env and adjust as needed for local testing.

# Host and ports for the mock servers (default: 127.0.0.1)
DZ_SANDBOX_HOST=127.0.0.1
DZ_CONTROL_PORT=4000
DZ_CHARGILY_PORT=4001
DZ_SATIM_PORT=4002
DZ_YALIDINE_PORT=4003

# Storage adapter: "memory" (fast, transient) or "sqlite" (persistent)
DZ_STORE=memory
DZ_SQLITE_PATH=./data/dz-sandbox.sqlite

# Deterministic PRNG seed for reproducible IDs and tokens
DZ_SEED=1337

# Directory containing custom YAML/JSON scenario definitions
DZ_SCENARIOS_DIR=./scenarios

# Optional bearer token for Control API (required if host is non-loopback)
# DZ_CONTROL_TOKEN=your-secure-control-token

# Webhook safety settings
DZ_ALLOW_LOCALHOST_WEBHOOKS=true
# DZ_WEBHOOK_ALLOWLIST=192.168.1.0/24

# -------------------------------------------------------------------
# Provider Integration URLs & Credentials (for client apps / tests)
# -------------------------------------------------------------------

# Chargily Pay v2 (Mock)
CHARGILY_BASE_URL=http://127.0.0.1:4001/api/v2
CHARGILY_SECRET_KEY=test_sk_dz_sandbox_chargily_secret

# SATIM E-Payment (Mock)
SATIM_BASE_URL=http://127.0.0.1:4002/payment/rest
SATIM_USERNAME=test_merchant
SATIM_PASSWORD=test_password

# Yalidine Express (Mock)
YALIDINE_BASE_URL=http://127.0.0.1:4003/v1
YALIDINE_API_ID=test_api_id
YALIDINE_API_TOKEN=test_api_token
YALIDINE_WILAYA_ERA=69
