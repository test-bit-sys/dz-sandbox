{
  "name": "@dz-sandbox/mock-baridimob",
  "version": "0.1.0",
  "description": "BaridiMob (Algérie Poste) local mock server simulating login, device confirmation, accounts, cards, transfers, and SMS OTP",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dz-sandbox/core": "0.1.0",
    "@fastify/formbody": "^9.0.1",
    "fastify": "^5.2.1",
    "zod": "^4.6.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/test-bit-sys/dz-sandbox.git",
    "directory": "packages/mock-baridimob"
  },
  "bugs": {
    "url": "https://github.com/test-bit-sys/dz-sandbox/issues"
  },
  "homepage": "https://github.com/test-bit-sys/dz-sandbox/tree/main/packages/mock-baridimob#readme",
  "keywords": [
    "algeria",
    "payment",
    "baridimob",
    "algerie-poste",
    "ccp",
    "mock",
    "sandbox",
    "testing"
  ]
