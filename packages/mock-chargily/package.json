    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dz-sandbox/core": "0.1.0",
    "@fastify/formbody": "^8.0.2",
    "fastify": "^5.2.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@chargily/chargily-pay": "^2.1.0"
  }
}
